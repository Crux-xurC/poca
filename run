#!/usr/bin/env bash
# Start Poca. Programs to look at (tezcatl, Emacs, ...) are started on their
# own for now; box will start them later.
set -euo pipefail

POCA_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
POCA_APP="$POCA_DIR/build/Release/poca"

if [[ ! -x "$POCA_APP" ]]; then
  echo "poca: not built: $POCA_APP" >&2
  echo "Build it first; see README.md." >&2
  exit 1
fi

exec "$POCA_APP" "$@"
